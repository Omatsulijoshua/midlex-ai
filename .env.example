# Midlex AI Frontend Configuration (Firebase OAuth Credentials)
# Get these settings from your Firebase Console (Project Settings -> Web App)

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend Server API URL.
# Local dev can use localhost. If using Render as the live backend, set this
# in Vercel Production to your Render service URL, for example:
# VITE_API_URL=https://midlex-ai-backend.onrender.com
VITE_API_URL=http://localhost:5000

# Server-side Gemini API key.
# If using the Render backend, add these in Render.
# If using Vercel /api/chat, add these in Vercel.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
